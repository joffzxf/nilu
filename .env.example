# 本地开发：复制为 .env
# 不配置 GitHub OAuth 也能玩；DEV_AUTH=1 时可以点「本地测试登录」体验完整榜单。
PORT=8787
HOST=127.0.0.1
DEV_AUTH=1

# GitHub OAuth App（Settings → Developer settings → OAuth Apps）
# Homepage URL: https://joffzxf.github.io/nilu/
# Authorization callback URL: 必须与下面完全一致（本地开发可用 http://127.0.0.1:8787/api/auth/github/callback）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://127.0.0.1:8787/api/auth/github/callback

# 允许的前端来源，逗号分隔。GitHub Pages 的 origin 是 https://joffzxf.github.io
APP_ORIGIN=https://joffzxf.github.io,http://127.0.0.1:8787,http://localhost:8787

# 可选
# DURATION_TICKS=3600
# MIN_RUN_RATIO=0.8
# SESSION_TTL_MS=7776000000
# CHALLENGE_TTL_MS=900000
